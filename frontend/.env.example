# Public browser configuration. These values identify infrastructure; none are secrets.
VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com
VITE_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_DOMAIN=https://<cognito-domain>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<dashboard-app-client-id>
